#!/bin/sh
# Git credential helper: emit the PAT only to Git on a credential request.

case "${1:-}" in
  get)
    if [ -z "${GH_PAT:-}" ]; then
      exit 1
    fi
    printf 'username=x-access-token\npassword=%s\n' "$GH_PAT"
    ;;
  store|erase)
    # Credentials come from GH_PAT; never persist or erase them here.
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
