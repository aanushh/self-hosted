{
    admin 0.0.0.0:2019
    email {$ACME_EMAIL}
}

(proxy-health) {
    fail_duration 30s
    max_fails 2
}

*.{$DOMAIN} {
    tls {
        dns cloudflare {$CLOUDFLARE_API_TOKEN}
        resolvers 1.1.1.1
    }
}

adguard.aanushh.com {
    reverse_proxy adguard:3000 {
        import proxy-health
    }
}

bentopdf.{$DOMAIN} {
    reverse_proxy bentopdf:8080 {
        import proxy-health
    }
}

homepage.aanushh.com {
    reverse_proxy homepage:3000 {
        import proxy-health
    }
}

